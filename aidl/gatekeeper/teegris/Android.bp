package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// A non-secure implementation of Gatekeeper in C++.
//
// A real device is required to run the TA code in a secure environment, as
// per CDD 9.11 [C-1-3]: "MUST perform the lock screen authentication in the
// isolated execution environment".
cc_binary {
    name: "android.hardware.gatekeeper-service.nonsecure",
    cflags: [
        "-fvisibility=hidden",
        "-Wall",
        "-Werror",
    ],
    relative_install_path: "hw",
    init_rc: ["android.hardware.gatekeeper-service.nonsecure.rc"],
    vintf_fragments: ["android.hardware.gatekeeper-service.nonsecure.xml"],
    shared_libs: [
        "android.hardware.gatekeeper-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libgatekeeper",
    ],
    header_libs: ["libhardware_headers"],
    srcs: [
        "GateKeeper.cpp",
        "service.cpp",
    ],
    vendor: true,
}
