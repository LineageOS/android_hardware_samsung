vintf_fragment {
    name: "android.hardware.sensors-samsung-multihal.xml",
    src: "android.hardware.sensors-samsung-multihal.xml",
    vendor: true,
}

cc_binary {
    name: "android.hardware.sensors-service.samsung-multihal",
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "HalProxySamsung.cpp",
        "service.cpp",
    ],
    init_rc: ["android.hardware.sensors-service.samsung-multihal.rc"],
    vintf_fragment_modules: ["android.hardware.sensors-samsung-multihal.xml"],
    header_libs: [
        "android.hardware.sensors@2.X-multihal.header",
        "android.hardware.sensors@2.X-shared-utils",
    ],
    shared_libs: [
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
        "android.hardware.sensors-V3-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libfmq",
        "libhidlbase",
        "liblog",
        "libpower",
        "libutils",
    ],
    static_libs: [
        "android.hardware.sensors@1.0-convert",
        "android.hardware.sensors@2.X-multihal",
        "android.hardware.sensors@aidl-multihal",
        "libaidlcommonsupport",
    ],
}

cc_library_shared {
    name: "sensors.sensorhub_wait_for_mcu",
    srcs: ["SensorHubWaitForMCUInit.cpp"],
    vendor: true,
}
