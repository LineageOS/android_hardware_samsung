
cc_library_static {
    name: "libhealth_samsung_aidl_impl",
    defaults: [
        "libhealth_aidl_common_defaults",
        "libhealth_aidl_charger_defaults",
    ],
    vendor: true,
    recovery_available: true,
    export_include_dirs: ["include"],
    export_static_lib_headers: [
        "libbatterymonitor",
    ],
    shared_libs: [
        "android.hardware.thermal-V3-ndk",
        "vendor.samsung.hardware.health-V1-ndk",
    ],
    srcs: [
        "ChargerUtils.cpp",
        "health-convert.cpp",
        "HalHealthLoop.cpp",
        "Health.cpp",
        "LinkedCallback.cpp",
        "SecBatteryMonitor.cpp",
        "SehHealth.cpp",
        "SehLinkedCallback.cpp",
    ],
    target: {
        recovery: {
            exclude_srcs: [
                "ChargerUtils.cpp",
                "SecBatteryMonitor.cpp",
                "SehHealth.cpp",
                "SehLinkedCallback.cpp",
            ],
            exclude_shared_libs: [
                "android.hardware.thermal-V3-ndk",
                "vendor.samsung.hardware.health-V1-ndk",
            ],
        },
    },
}
