cc_binary {
    name: "vendor.lineage.health-service.samsung",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.health-service.samsung.rc"],
    vintf_fragments: ["vendor.lineage.health-service.samsung.xml"],
    cflags: select(soong_config_variable("lineage_health", "charging_control_charging_path"), {
        any @ flag_val: ["-DHEALTH_CHARGING_CONTROL_CHARGING_PATH=\"" + flag_val + "\""],
        default: [],
    }) + select(soong_config_variable("lineage_health", "charging_control_deadline_path"), {
        any @ flag_val: ["-DHEALTH_CHARGING_CONTROL_DEADLINE_PATH=\"" + flag_val + "\""],
        default: [],
    }) + select(soong_config_variable("lineage_health", "charging_control_limit_start_path"), {
        any @ flag_val: ["-DHEALTH_CHARGING_CONTROL_LIMIT_START_PATH=\"" + flag_val + "\""],
        default: [],
    }) + select(soong_config_variable("lineage_health", "charging_control_limit_stop_path"), {
        any @ flag_val: ["-DHEALTH_CHARGING_CONTROL_LIMIT_STOP_PATH=\"" + flag_val + "\""],
        default: [],
    }) + select(soong_config_variable("lineage_health", "charging_control_charging_enabled"), {
        any @ flag_val: ["-DHEALTH_CHARGING_CONTROL_CHARGING_ENABLED=\"" + flag_val + "\""],
        default: ["-DHEALTH_CHARGING_CONTROL_CHARGING_ENABLED=\"1\""],
    }) + select(soong_config_variable("lineage_health", "charging_control_charging_disabled"), {
        any @ flag_val: ["-DHEALTH_CHARGING_CONTROL_CHARGING_DISABLED=\"" + flag_val + "\""],
        default: ["-DHEALTH_CHARGING_CONTROL_CHARGING_DISABLED=\"0\""],
    }) + select(soong_config_variable("lineage_health", "charging_control_supports_bypass"), {
        true: ["-DHEALTH_CHARGING_CONTROL_SUPPORTS_BYPASS"],
        false: [],
        default: ["-DHEALTH_CHARGING_CONTROL_SUPPORTS_BYPASS"],
    }) + select(soong_config_variable("lineage_health", "charging_control_supports_deadline"), {
        true: ["-DHEALTH_CHARGING_CONTROL_SUPPORTS_DEADLINE"],
        false: [],
        default: [],
    }) + select(soong_config_variable("lineage_health", "charging_control_supports_limit"), {
        true: ["-DHEALTH_CHARGING_CONTROL_SUPPORTS_LIMIT"],
        false: [],
        default: [],
    }) + select(soong_config_variable("lineage_health", "charging_control_supports_toggle"), {
        true: ["-DHEALTH_CHARGING_CONTROL_SUPPORTS_TOGGLE"],
        false: [],
        default: ["-DHEALTH_CHARGING_CONTROL_SUPPORTS_TOGGLE"],
    }) + select(soong_config_variable("lineage_health", "fast_charge_node"), {
        any @ flag_val: ["-DHEALTH_FAST_CHARGE_NODE=\"" + flag_val + "\""],
        default: ["-DHEALTH_FAST_CHARGE_NODE="],
    }) + select(soong_config_variable("lineage_health", "fast_charge_value_none"), {
        any @ flag_val: ["-DHEALTH_FAST_CHARGE_VALUE_NONE=\"" + flag_val + "\""],
        default: ["-DHEALTH_FAST_CHARGE_VALUE_NONE="],
    }) + select(soong_config_variable("lineage_health", "fast_charge_value_fast_charge"), {
        any @ flag_val: ["-DHEALTH_FAST_CHARGE_VALUE_FAST_CHARGE=\"" + flag_val + "\""],
        default: ["-DHEALTH_FAST_CHARGE_VALUE_FAST_CHARGE="],
    }) + select(soong_config_variable("lineage_health", "fast_charge_value_super_fast_charge"), {
        any @ flag_val: ["-DHEALTH_FAST_CHARGE_VALUE_SUPER_FAST_CHARGE=\"" + flag_val + "\""],
        default: ["-DHEALTH_FAST_CHARGE_VALUE_SUPER_FAST_CHARGE="],
    }),
    srcs: [
        "service.cpp",
        "ChargingControl.cpp",
        "FastCharge.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.lineage.health-V2-ndk",
    ],
}
