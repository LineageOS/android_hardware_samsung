package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.gnss-service.samsung",
    relative_install_path: "hw",
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    defaults: [
        "gnss_use_latest_hal_aidl_ndk_shared",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libbinder_ndk",
        "libhidlbase",
        "libutils",
        "liblog",
        "android.hardware.gnss@2.1",
        "android.hardware.gnss@2.0",
        "android.hardware.gnss@1.0",
        "android.hardware.gnss.measurement_corrections@1.1",
        "android.hardware.gnss.measurement_corrections@1.0",
        "android.hardware.gnss.visibility_control@1.0",
    ],
    srcs: [
        "AGnssRil.cpp",
        "AGnss.cpp",
        "Gnss.cpp",
        "GnssBackend.cpp",
        "GnssProtocol.cpp",
        "GnssAntennaInfo.cpp",
        "GnssAssistanceInterface.cpp",
        "GnssBatching.cpp",
        "GnssDebug.cpp",
        "GnssGeofence.cpp",
        "GnssNavigationMessageInterface.cpp",
        "GnssPowerIndication.cpp",
        "GnssPsds.cpp",
        "GnssConfiguration.cpp",
        "GnssMeasurementInterface.cpp",
        "GnssVisibilityControl.cpp",
        "MeasurementCorrectionsInterface.cpp",
        "service.cpp",
    ],
    static_libs: [
        "android.hardware.gnss@common-default-lib",
    ],
    required: [
        "android.hardware.location.gps.prebuilt.xml",
    ]
}

prebuilt_etc {
    name: "gnss-samsung.rc",
    src: "gnss-samsung.rc",
    installable: false,
}

prebuilt_etc {
    name: "gnss-samsung.xml",
    src: "gnss-samsung.xml",
    sub_dir: "vintf",
    installable: false,
}
