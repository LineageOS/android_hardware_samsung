package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.gnss-service.samsung",
    relative_install_path: "hw",
    init_rc: ["android.hardware.gnss-service.samsung.rc"],
    vintf_fragments: ["android.hardware.gnss-service.samsung.xml"],
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    defaults: [
        "gnss_use_latest_hal_aidl_ndk_shared",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libutils",
        "liblog",
    ],
    srcs: [
        "Gnss.cpp",
        "GnssBackend.cpp",
        "GnssProtocol.cpp",
        "service.cpp",
    ],
    required: [
        "android.hardware.location.gps.prebuilt.xml",
    ]
}
