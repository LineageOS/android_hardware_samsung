package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.audio.service-aidl.samsung",
    relative_install_path: "hw",
    init_rc: ["android.hardware.audio.service-aidl.samsung.rc"],
    vintf_fragments: ["android.hardware.audio.service-aidl.samsung.xml"],
    defaults: [
        "aidlaudioservice_defaults",
        "latest_android_hardware_audio_core_ndk_shared",
        "latest_android_hardware_audio_core_sounddose_ndk_shared",
        "latest_android_hardware_bluetooth_audio_ndk_shared",
        "latest_android_media_audio_common_types_ndk_shared",
    ],
    srcs: [
        "LegacyUtils.cpp",
        "ModuleLegacy.cpp",
        "StreamLegacy.cpp",
        "TelephonyLegacy.cpp",
        "main.cpp",
    ],
    static_libs: [
        "libaudioserviceexampleimpl",
    ],
    shared_libs: [
        "android.hardware.bluetooth.audio-impl",
        "libaudio_aidl_conversion_common_ndk",
        "libbluetooth_audio_session_aidl",
        "libhardware",
        "libmedia_helper",
        "libstagefright_foundation",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wthread-safety",
        "-DBACKEND_NDK",
    ],
    vendor: true,
}

cc_binary {
    name: "android.hardware.audio.effect.service-aidl.samsung",
    relative_install_path: "hw",
    defaults: [
        "aidlaudioeffectservice_defaults",
        "latest_android_hardware_audio_common_ndk_shared",
    ],
    srcs: [
        "EffectFactory.cpp",
        "EffectLegacy.cpp",
        "EffectMain.cpp",
    ],
    shared_libs: [
        "libaudio_aidl_conversion_effect_ndk",
        "libeffectconfig",
    ],
    header_libs: [
        "libhardware_headers",
    ],
    vendor: true,
}
