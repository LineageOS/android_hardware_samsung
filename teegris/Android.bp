cc_binary {
    name: "hermesd",
    init_rc: ["hermesd.rc"],
    shared_libs: ["libteecl"],
    header_libs: ["libteecl_headers"],
    srcs: ["hermes.c"],
    vendor: true,
}

cc_library_headers {
    name: "libteecl_headers",
    export_include_dirs: ["."],
}

cc_library_shared {
    name: "libteecl",
    vendor: true,
}
