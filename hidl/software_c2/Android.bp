cc_binary {
    name: "samsung.software.media.c2@1.0-service",
    vendor: true,
    relative_install_path: "hw",

    init_rc: [
        "samsung.software.media.c2@1.0-service.rc",
    ],

    vintf_fragments: select(soong_config_variable("samsungVars", "c2_instance_type"), {
        "default0": ["sec_c2_manifest_default0.xml"],
        default: ["sec_c2_manifest_default.xml"],
    }),

    defaults: [
        "libcodec2-hidl-defaults",
    ],
    srcs: [
        "vendor.cpp",
    ],

    shared_libs: [
        "libavservices_minijail",
        "libbinder",
    ]
     + select(soong_config_variable("samsungVars", "target_componentstore_library"), {
        any @ flag_val: [flag_val],
        default: [],
    }),

    required: [
        "samsung.software.media.c2-base-policy",
        "samsung.software.media.c2-ext-policy",
    ],
}

prebuilt_etc {
    name: "samsung.software.media.c2-base-policy",
    vendor: true,
    sub_dir: "seccomp_policy",

    arch: {
        arm: {
            src: "seccomp_policy/samsung.software.media.c2-base-arm.policy",
        },
        arm64: {
            src: "seccomp_policy/samsung.software.media.c2-base-arm64.policy",
        },
    },
}

prebuilt_etc {
    name: "samsung.software.media.c2-ext-policy",
    vendor: true,
    sub_dir: "seccomp_policy",

    arch: {
        arm: {
            src: "seccomp_policy/samsung.software.media.c2-ext-arm.policy",
        },
        arm64: {
            src: "seccomp_policy/samsung.software.media.c2-ext-arm64.policy",
        },
    },
}
