package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.gnss@2.1-service.samsung",
    init_rc: ["android.hardware.gnss@2.1-service.samsung.rc"],
    relative_install_path: "hw",
    vendor: true,
    vintf_fragments: ["android.hardware.gnss@2.1-service.samsung.xml"],
    srcs: [
        "service.cpp",
    ],
    shared_libs: [
        "android.frameworks.sensorservice@1.0",
        "android.hardware.gnss@1.0",
        "android.hardware.gnss@1.1",
        "android.hardware.gnss@2.0",
        "android.hardware.gnss@2.1",
        "libbase",
        "libbinder",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "libutils",
    ],
}
