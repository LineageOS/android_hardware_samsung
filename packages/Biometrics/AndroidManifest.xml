<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.samsung.biometrics"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.MANAGE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- needed to talk to system services -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN"/>

    <application
        android:label="SamsungBiometrics"
        android:persistent="true">

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".SamsungBiometricService"
            android:exported="true"
            android:permission="SamsungBiometricService">
        </service>

        <activity
            android:name=".DebugActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
