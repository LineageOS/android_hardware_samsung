android_app {
    name: "SamsungBiometrics",
    srcs: [
        "src/**/*.java",
    ],

    aidl: {
        include_dirs: [
            "frameworks/base/core/java",
        ],
    },

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
}
