hidl_package_root {
    name: "vendor.samsung.hardware",
    use_current: true,
}

aidl_interface {
    name: "vendor.samsung.hardware.sysinput",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: ["aidl/vendor/samsung/hardware/sysinput/*.aidl"],
    stability: "vintf",
    owner: "samsung",

    backend: {
        java: {
            sdk_version: "module_current",
            min_sdk_version: "30",
            lint: {
                // Disable linter to avoid error about fixed size arrays.
                // Interface will only be accessed on devices >= U.
                enabled: false,
            },
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}
