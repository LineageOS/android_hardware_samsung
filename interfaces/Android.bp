hidl_package_root {
    name: "vendor.samsung.hardware",
    use_current: true,
}

aidl_interface {
    name: "vendor.samsung.hardware.sysinput",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: ["aidl/vendor/samsung/hardware/sysinput/*.aidl"],
    stability: "vintf",
    owner: "samsung",

    backend: {
        cpp: {
            enabled: true,
        },
        java: {
            sdk_version: "module_current",
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}
