aidl_interface {
    name: "vendor.samsung.hardware.health",
    vendor_available: true,
    srcs: [
        "vendor/samsung/hardware/health/*.aidl",
    ],
    stability: "vintf",
    owner: "samsung",
    imports: [
        "android.hardware.health-V4",
    ],
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: ["android.hardware.health-V4"],
        },
    ],
}
